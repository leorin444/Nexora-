@page "/audit"

<PageTitle>Audit Log Viewer</PageTitle>

<div class="container-fluid">
    <h1 class="mb-4">Audit Logs</h1>
    <p class="text-muted">Security and system activity history.</p>

    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Timestamp (UTC)</th>
                <th>User / Identity</th>
                <th>Domain</th>
                <th>Action</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="5" class="text-center text-muted">No audit logs recorded yet.</td>
            </tr>
        </tbody>
    </table>
</div>
