@page "/features"
@attribute [Authorize(Roles = "Admin")]
@inject Nexora.Admin.Services.NexoraApiClient ApiClient

<PageTitle>Feature Flag Management</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Feature Flag Management</h1>
            <p class="text-muted mb-0">Centrally enable or disable platform capabilities for personal and couple modes in real-time.</p>
        </div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="LoadFeatures" disabled="@isLoading">
            <span class="bi bi-arrow-clockwise me-1"></span>Refresh
        </button>
    </div>

    @if (isLoading)
    {
        <div class="d-flex align-items-center gap-2 text-primary p-3">
            <div class="spinner-border spinner-border-sm text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <span>Loading feature toggles...</span>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            <span class="bi bi-exclamation-triangle-fill me-2"></span>
            <div>@errorMessage</div>
        </div>
    }
    else if (features != null)
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Feature Key</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var feature in features)
                        {
                            <tr>
                                <td><strong>@feature.Key</strong></td>
                                <td>
                                    @if (feature.Value)
                                    {
                                        <span class="badge bg-success">Enabled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Disabled</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm @(feature.Value ? "btn-outline-danger" : "btn-outline-success")"
                                            @onclick="() => ToggleFeature(feature.Key, !feature.Value)">
                                        @(feature.Value ? "Disable" : "Enable")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private IDictionary<string, bool>? features;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadFeatures();
    }

    private async Task LoadFeatures()
    {
        isLoading = true;
        try
        {
            features = await ApiClient.GetFeatureFlagsAsync();
            errorMessage = null;
        }
        catch (Exception)
        {
            errorMessage = "Unable to connect to backend API to retrieve feature flags.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleFeature(string name, bool newState)
    {
        var success = await ApiClient.UpdateFeatureFlagAsync(name, newState);
        if (success)
        {
            if (features != null) features[name] = newState;
        }
        else
        {
            await LoadFeatures();
        }
    }
}
