@page "/users"

<PageTitle>User & Couple Management</PageTitle>

<div class="container-fluid">
    <h1 class="mb-4">User & Couple Management</h1>
    <p class="text-muted">Overview of platform users and active couple relationships.</p>

    <div class="alert alert-info">
        <strong>Privacy Notice:</strong> Administrators can view account status and couple linkages, but cannot view private user content (notes, chat history, journals).
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>User ID</th>
                <th>Email</th>
                <th>Name</th>
                <th>Status</th>
                <th>Couple Status</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="5" class="text-center text-muted">No users registered yet or backend disconnected.</td>
            </tr>
        </tbody>
    </table>
</div>
